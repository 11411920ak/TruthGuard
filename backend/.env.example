# =================================================================
# TruthGuard — Backend Environment Configuration Example
# Copy this file to .env and fill in your values
# =================================================================

# ── Database (SQLite for dev, PostgreSQL for production) ──
DATABASE_URL=sqlite+aiosqlite:///./truthguard.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/truthguard

# ── Server ──
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ── Security ──
SECRET_KEY=change-this-to-a-random-secret-key-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# =================================================================
# External AI & Fact-Checking API Keys (Optional)
# =================================================================

# 1. AI API Key (Google Gemini or OpenAI)
AI_API_KEY=your_gemini_or_openai_api_key_here

# 2. Search API Key (Serper Google Search)
SEARCH_API_KEY=your_serper_search_api_key_here

# 3. Google Fact Check Tools API Key
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# 4. Tavily AI Search API Key
TAVILY_API_KEY=your_tavily_api_key_here

# 5. NewsAPI Key (https://newsapi.org)
NEWS_API_KEY=your_news_api_key_here

