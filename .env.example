# =================================================================
# TruthGuard — Environment Configuration
# Copy this file to .env and customize values for your deployment
# =================================================================

# ── Application Environment ──
ENVIRONMENT=production
DEBUG=false

# ── Database Configuration ──
# Default: Embedded SQLite database with async driver (aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./truthguard.db

# Production Alternative: Managed PostgreSQL
# DATABASE_URL=postgresql+asyncpg://truthguard_user:secure_password@postgres:5432/truthguard_db

# ── Backend Server Settings ──
HOST=0.0.0.0
PORT=8000

# ── Security & Authentication ──
# Generate a secure 64-char string: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000

# ── External AI & Fact-Checking APIs (Optional) ──
# TruthGuard includes built-in heuristic/NLP extractors and real-time scrapers.
# Add API keys here if augmenting with commercial LLMs or search engines:
AI_API_KEY=
SEARCH_API_KEY=

# ── Frontend Configuration ──
VITE_API_BASE_URL=http://localhost:8000
